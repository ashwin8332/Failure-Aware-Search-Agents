# Search APIs (optional — DuckDuckGo mock used when missing)
SERPAPI_KEY=your_serpapi_key_here

# Google ADK / Gemini (required for live ADK inference)
GOOGLE_API_KEY=your_google_api_key_here

# Hugging Face (optional, for gated models)
HF_TOKEN=your_huggingface_token_here

# Weights & Biases (optional)
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=failure-aware-dpo

# Model paths
BASE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
DPO_CHECKPOINT=./checkpoints/dpo-failure-aware

# Live inference backend: mock | ollama | adk
INFERENCE_BACKEND=mock

# Ollama (rollouts + live inference when INFERENCE_BACKEND=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3:mini
USE_DPO=false

# Rate limiting
MCP_RATE_LIMIT_PER_MINUTE=10
